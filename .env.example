# PostgreSQL. For Neon/Vercel, DATABASE_URL is pooled and DIRECT_URL is direct.
DATABASE_URL="postgresql://caviar:caviar_password@localhost:5432/caviar_beauty?schema=public"
DIRECT_URL="postgresql://caviar:caviar_password@localhost:5432/caviar_beauty?schema=public"

# Auth secrets (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"

# OAuth (optional - only needed if enabling Google/Apple sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="your-apple-bundle-id"

# Razorpay (REQUIRED for payments - get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email (SMTP - required for OTP, password reset, order confirmations)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# App
FRONTEND_URL="http://localhost:5173"
# Optional comma-separated exact additional origins (for example Vercel previews).
FRONTEND_URLS=
PORT="4000"
NODE_ENV="development"

# Supabase Storage (needed for durable uploads on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional service settings
CRON_SECRET=
ORDER_EXPIRY_MINUTES=15
AUTO_CANCEL_INTERVAL_MS=300000
MAX_IMAGE_DIMENSION=2000
