# PostgreSQL. For Neon/Vercel, DATABASE_URL is pooled and DIRECT_URL is direct.
DATABASE_URL="postgresql://caviar:caviar_password@localhost:5432/caviar_beauty?schema=public"
DIRECT_URL="postgresql://caviar:caviar_password@localhost:5432/caviar_beauty?schema=public"

# Auth secrets (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"

# OAuth (optional - only needed if enabling Google/Apple sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="your-apple-bundle-id"

# Paytm Payment Gateway (REQUIRED for payments - get from https://dashboard.paytmpayments.com)
# .env.example ships placeholders on purpose: checkout returns HTTP 503 until real values exist.
PAYTM_ENV="staging"
PAYTM_MID="your_paytm_mid"
PAYTM_MERCHANT_KEY="your_paytm_merchant_key"
# WEBSTAGING for staging, DEFAULT for production. Leave blank to derive from PAYTM_ENV.
PAYTM_WEBSITE_NAME=
# Public URL Paytm posts the browser return to (auto-derived from BACKEND_PUBLIC_URL).
PAYTM_CALLBACK_URL=
# Optional API host override (only if Paytm support gives you a different host).
PAYTM_HOST=
# Optional: used by `npm run verify:payments` to print the exact callback/webhook URLs.
BACKEND_PUBLIC_URL=

# Email (SMTP - required for email verification, password reset, order emails)
# Gmail needs a 16-character App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT your normal account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
# Optional display/from address. Defaults to SMTP_USER.
MAIL_FROM=
# Where contact-form submissions and new-order notifications are sent.
# Defaults to MAIL_FROM / SMTP_USER. Set it to the shop inbox.
CONTACT_TO=

# Phone verification - Firebase Phone Auth (PREFERRED, free on the Spark plan)
# Firebase console -> Project settings -> General -> your Web API key + Project ID.
# The browser SDK sends the SMS; the API only checks the resulting ID token, so
# these two values are all the server needs. When they are set, Twilio is unused.
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_PROJECT_ID="your_firebase_project_id"

# SMS / Phone OTP fallback (Twilio) - only used when Firebase is NOT configured.
# Console: https://console.twilio.com -> Account Info (SID/token) and a phone number.
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+10000000000"

# Optional: dedicated key for hashing OTP codes. Falls back to JWT_SECRET.
OTP_SECRET=

# App
FRONTEND_URL="http://localhost:5173"
# Optional comma-separated exact additional origins (for example Vercel previews).
FRONTEND_URLS=
PORT="4000"
NODE_ENV="development"

# Supabase Storage (needed for durable uploads on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional service settings
CRON_SECRET=
ORDER_EXPIRY_MINUTES=15
AUTO_CANCEL_INTERVAL_MS=300000
MAX_IMAGE_DIMENSION=2000
