{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "outputDirectory": null,
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-cancel",
      "schedule": "0 0 * * *"
    }
  ]
}
